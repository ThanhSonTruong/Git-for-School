\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Raw measurements for the object-at-infinity experiment. The focal length is $d_2$ minus $d_1$. Which is just the distance from the lens to the image.}}{3}{}\protected@file@percent }
